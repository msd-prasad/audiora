# Used only by the FastAPI service in services/story-audio; never expose these to Vite.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# Optional JSON: {"en-gb":"<ElevenLabs voice ID>","es":"<ElevenLabs voice ID>","es-mx":"<ElevenLabs voice ID>"}
ELEVENLABS_LOCALE_VOICE_MAP=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1-mini
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Leave empty when FastAPI serves the built UI (the default production setup).
VITE_API_URL=

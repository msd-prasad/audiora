# OpenAI is optional in local mock mode. Without it, Phase 1 uses a polished local fallback.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Reserved for deployments that route other creative services through Anthropic.
ANTHROPIC_API_KEY=
PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# External engines: mock is the default. Switch a MODE to live plus a URL when the service is ready.
STORY_ENGINE_MODE=mock
STORY_ENGINE_URL=http://127.0.0.1:8000/generate-story
AUDIO_ENGINE_MODE=mock
AUDIO_ENGINE_URL=http://127.0.0.1:8001/render-audio
GENERATED_AUDIO_DIR=../hackathon_preprocessor/hackathon/rendered

# Mock behavior, useful for testing the full UI's resilience.
MOCK_MIN_DELAY_MS=1500
MOCK_MAX_DELAY_MS=4000
MOCK_ERROR_RATE=0.03

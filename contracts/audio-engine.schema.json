{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiora.dev/contracts/audio-engine.schema.json",
  "title": "Audiora Audio Engine Contract v1",
  "description": "The Audio Engine accepts exactly a Story Engine response and returns a completed mixed audio artifact.",
  "oneOf": [
    { "$ref": "story-engine.schema.json#/$defs/response" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["audio_url", "duration_seconds", "scene_markers", "status", "error"],
      "properties": {
        "audio_url": { "type": "string", "minLength": 1 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "scene_markers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sceneMarker" } },
        "status": { "type": "string", "enum": ["completed", "failed"] },
        "error": { "type": ["string", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "completed" } } }, "then": { "properties": { "error": { "type": "null" } } } },
        { "if": { "properties": { "status": { "const": "failed" } } }, "then": { "properties": { "error": { "type": "string", "minLength": 1 } } } }
      ]
    },
    "sceneMarker": {
      "type": "object", "additionalProperties": false, "required": ["scene_id", "start_seconds", "end_seconds"],
      "properties": {
        "scene_id": { "type": "string", "minLength": 1 },
        "start_seconds": { "type": "number", "minimum": 0 }, "end_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}

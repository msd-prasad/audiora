{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audiora.dev/contracts/story-engine.schema.json",
  "title": "Audiora Story Engine Contract v1",
  "description": "The Story Engine receives narratable prose and produces a structured audio drama script.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["briefStory", "title", "genre"],
      "properties": {
        "briefStory": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "genre": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story_id", "title", "genre", "language", "global_settings", "scenes"],
      "properties": {
        "story_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "genre": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 2 },
        "global_settings": { "$ref": "#/$defs/globalSettings" },
        "scenes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scene" } }
      }
    },
    "globalSettings": {
      "type": "object", "additionalProperties": false,
      "required": ["master_volume", "default_voice", "background_music_volume", "sfx_volume", "speech_volume", "output_format", "sample_rate"],
      "properties": {
        "master_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "default_voice": { "type": "string", "minLength": 1 },
        "background_music_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "sfx_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "speech_volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "output_format": { "type": "string", "enum": ["mp3"] },
        "sample_rate": { "type": "integer", "enum": [22050, 24000, 44100, 48000] }
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_id", "title", "description", "ambience", "background_music", "dialogue"],
      "properties": {
        "scene_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "ambience": { "type": "array", "items": { "$ref": "#/$defs/ambience" } },
        "background_music": { "$ref": "#/$defs/music" },
        "dialogue": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dialogue" } }
      }
    },
    "ambience": {
      "type": "object", "additionalProperties": false,
      "required": ["sound", "volume", "loop", "interval"],
      "properties": {
        "sound": { "type": "string", "minLength": 1 }, "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" }, "interval": { "type": "number", "minimum": 0 }
      }
    },
    "music": {
      "type": "object", "additionalProperties": false,
      "required": ["track", "volume", "fade_in_ms", "fade_out_ms"],
      "properties": {
        "track": { "type": "string", "minLength": 1 }, "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "fade_in_ms": { "type": "integer", "minimum": 0 }, "fade_out_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "dialogue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sentence", "character", "metadata", "background_sounds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "sentence": { "type": "string", "minLength": 1 },
        "character": { "$ref": "#/$defs/character" }, "metadata": { "$ref": "#/$defs/metadata" },
        "background_sounds": { "type": "array", "items": { "$ref": "#/$defs/backgroundSound" } }
      }
    },
    "character": {
      "type": "object", "additionalProperties": false, "required": ["name", "voice"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "voice": { "type": "string", "minLength": 1 } }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["emotion", "tone", "pace", "pitch", "volume", "pause_before_ms", "pause_after_ms", "emphasis", "reverb"],
      "properties": {
        "emotion": { "type": "string", "minLength": 1 }, "tone": { "type": "string", "minLength": 1 },
        "pace": { "type": "number", "minimum": 0.5, "maximum": 2 }, "pitch": { "type": "number", "minimum": -20, "maximum": 20 },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 }, "pause_before_ms": { "type": "integer", "minimum": 0 },
        "pause_after_ms": { "type": "integer", "minimum": 0 }, "emphasis": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "reverb": { "type": "string", "enum": ["none", "light", "medium", "heavy"] }
      }
    },
    "backgroundSound": {
      "type": "object", "additionalProperties": false, "required": ["sound", "start_offset_ms", "duration_ms", "volume"],
      "properties": {
        "sound": { "type": "string", "minLength": 1 }, "start_offset_ms": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 }, "volume": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
